# Agent/AI 配置文件
AGENTS.md
CLAUDE.md

# 构建输出（Quartz 生成的静态站点）
# APPhysicsC/knowledge-graph/ 是构建输出，源文件在 quartz-gh/content/
APPhysicsC/knowledge-graph/

# 部署目录
deploy/

# 开发环境
.claude/

# 子模块（如果需要单独管理）
# quartz-gh/quartz/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志
*.log

# Python 缓存（build_data.py / 诊断脚本会生成）
__pycache__/
*.pyc

# 环境变量（含数据库连接串等凭据，绝不入库）
.env
.env.local
.env.*.local

# SCF 打包产物
*.zip

# 依赖目录：不带尾斜杠，因为本地开发时 node_modules 常做软链，
# 写成 node_modules/ 匹不上软链（git 把软链当文件），会被误提交
node_modules

# Office Hour 云函数：.env 里的 MONGO_URI 等同于凭据（该库无账号密码），绝不入库
OfficeHour/api/.env
