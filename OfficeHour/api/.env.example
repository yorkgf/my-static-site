# Office Hour API 环境变量
# 复制成 .env 使用；.env 已被 .gitignore 忽略，不要提交

# ── 必需 ─────────────────────────────────────────────
# MongoDB 连接串（与 FADsys 同一实例；库内靠防火墙 IP 白名单保护，无账号密码）
MONGO_URI=mongodb://<轻量服务器公网IP>:27017

# 登录要查 GHA.Teachers，业务数据也写在同一个库
DB_NAME=GHA

# JWT 密钥。
# ★ 想复用老师在 FAD 的登录态（SSO，免二次登录）：把这里配成与 FADsys 函数完全相同的 JWT_SECRET。
#   token payload 结构 {email, name} 与 FADsys 一致，配成一样就能直接互认。
#   若只生成独立密钥，老师需要在 Office Hour 页面单独登录一次，其余功能不受影响。
JWT_SECRET=<用 node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" 生成>

# ── 可选（有合理默认值）───────────────────────────────
# 教师表在另一个库时才需要；默认等于 DB_NAME
#TEACHER_DB_NAME=GHA
#TEACHERS_COLLECTION=Teachers
#OFFICEHOURS_COLLECTION=Office_Hours
#AUDIT_COLLECTION=Office_Hour_Audit
# 老师删掉的排班表行会在这里留碑，防止下次导入复活
#DELETIONS_COLLECTION=Office_Hour_Deletions
# 班级注册表（见过的班级一律留着，以免某个班最后一条被改走后选不到）
#CLASS_REGISTRY_COLLECTION=Office_Hour_Classes

# 密钥轮换期同时接受旧密钥签发的 token
#JWT_SECRET_OLD=<旧的 JWT_SECRET>

JWT_EXPIRES_IN=7d

# 学期标识，对应 Excel 里的 (26-27)
# 注意：变量名必须带 OH_ 前缀 —— 裸 TERM 是终端类型变量，会被 shell 污染成 xterm-256color
OH_TERM=26-27

# 管理员组：取自 FADsys userGroups.js 的 ADMIN_GROUPS（S=系统管理员, A=管理员A/校领导）
ADMIN_GROUPS=S,A

# ── 老师自助相关 ────────────────────────────────────
# 单人自助值班条数上限（防误操作一口气刷几十条）
#OH_TEACHER_MAX_SLOTS=12
# 额外允许老师选的班级，逗号分隔：用于“本学期还没排但可以先选”的班
#OH_CLASSES=G10-4,G11-4

# 限流（读：学生轮询；登录：防爆破；写：防误操作刷库）
#READ_RATE_MAX=600
#LOGIN_RATE_MAX=20
#WRITE_RATE_MAX=120

NODE_ENV=development
PORT=9000
