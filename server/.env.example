# ── AP Business Groups API 配置 ──
# 复制为 .env 用于本地调试；生产环境在 SCF 控制台「函数配置 → 环境变量」里配置。
# 部署方式与 FADsys 相同：Web 函数 + MongoDB 公网 IP，安全边界靠轻量服务器防火墙 IP 白名单。

# MongoDB 连接串（与 FADsys 相同格式，无认证，靠服务器防火墙限制来源 IP）
# 生产：mongodb://<轻量服务器公网IP>:27017
# 本地：mongodb://127.0.0.1:27017
MONGO_URI=mongodb://127.0.0.1:27017

# 数据库名（默认 apbusiness）
DB_NAME=apbusiness

# JWT 签名密钥：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_random_64_hex_string

# 老师登录密码（学生不知道这个密码就无法打分/分配项目）
TEACHER_PASSWORD=CHANGE_ME_teacher_password

# 仅 nginx 反代形态使用；SCF Web 函数形态留空
ORIGIN_SECRET=

PORT=9000
NODE_ENV=development
